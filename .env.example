# Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase (https://supabase.com)
# Get these from: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email API (https://resend.com - free 3,000 emails/month)
RESEND_API_KEY=re_your_api_key

# Staff email to receive chat notifications and contact form submissions
STAFF_EMAIL=info@sunrisegroupltd.in

# CDN Base URL (Cloudflare R2 or any CDN)
# Leave EMPTY to use local /images/ and /videos/ paths (current behavior)
# Set to your CDN URL when ready (e.g., https://pub-abc123.r2.dev)
# When set, all image/video paths will be prefixed with this URL
NEXT_PUBLIC_CDN_BASE_URL=

# Google Gemini AI (https://aistudio.google.com)
# Powers the support chat widget with context-aware answers about Sunrise Constructions.
# Free tier available. Without this key, chat falls back to creating support tickets.
GEMINI_API_KEY=your_gemini_api_key

# Admin Dashboard — Authentication handled by Supabase Auth
# Run `database-setup.sql` in Supabase SQL Editor, then `npm run create-superadmin`
# to create tables and the first super admin account.
# The script reads the super admin credentials from these env vars:
SUPERADMIN_EMAIL=your-superadmin-email@domain.com
SUPERADMIN_PASSWORD=change-this-strong-password
